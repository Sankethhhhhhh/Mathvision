# Python & Virtual Environment
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Jupyter Notebooks
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Data & Large Artifacts (Keep directory structure with .gitkeep)
# Raw archives + 500k extracted files stay local-only.
data/raw/*
!data/raw/.gitkeep
# Processed: ignore bulky binaries, but TRACK small manifests/maps/reports.
data/processed/*
!data/processed/.gitkeep
!data/processed/*.json
!data/processed/*.csv
data/test/*
!data/test/.gitkeep

# Models (Keep metadata/json, ignore large weight checkpoints if needed)
models/*.h5
models/*.pth
models/*.pt

# IDEs & OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs & Temporary files
*.log
scratch/
